BEGIN task_process_audit
COMMAND bash -c $'\n  set -u -o pipefail\n  task_root=$1\n  tee_pid=$2\n  declare -A excluded=()\n  ancestor=$$\n  while [ "$ancestor" -gt 1 ] && [ -r "/proc/$ancestor/stat" ]; do\n    excluded[$ancestor]=1\n    ancestor=$(awk "{print \\$4}" "/proc/$ancestor/stat")\n  done\n  excluded[$tee_pid]=1\n  matches=0\n  for proc_path in /proc/[0-9]*; do\n    pid=${proc_path#/proc/}\n    [ -n "${excluded[$pid]:-}" ] && continue\n    [ -r "$proc_path/cmdline" ] || continue\n    cmdline=$(tr "\\0" " " < "$proc_path/cmdline" 2>/dev/null) || continue\n    case "$cmdline" in\n      *"$task_root"*)\n        printf "%s\\t%s\\n" "$pid" "$cmdline"\n        matches=$((matches + 1))\n        ;;\n    esac\n  done\n  printf "task_process_matches=%d\\n" "$matches"\n  test "$matches" -eq 0\n' _ /home/dev/ws_iap/src/iap/results/icra27/icra028 3228564
END task_process_audit exit=0 log=/home/dev/ws_iap/src/iap/results/icra27/icra028/logs/task_process_audit.log
