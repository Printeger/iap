Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 90; 90; 90
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw obstacles at failure
      Enabled: true
      Topic:
        Value: /iap/failure_map/raw
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Transformer: FlatColor
      Color: 60; 65; 72
      Style: Boxes
      Size (m): 0.10000000149
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Inflated obstacles at failure
      Enabled: true
      Topic:
        Value: /iap/failure_map/inflated
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Transformer: FlatColor
      Color: 180; 185; 190
      Style: Boxes
      Size (m): 0.10000000149
      Alpha: 0.15
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Observed free slice
      Enabled: true
      Topic:
        Value: /iap/failure_map/observed
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Transformer: FlatColor
      Color: 30; 190; 160
      Style: Flat Squares
      Size (m): 0.10000000149
      Alpha: 0.45
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Unknown slice
      Enabled: true
      Topic:
        Value: /iap/failure_map/unknown
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Transformer: FlatColor
      Color: 165; 75; 190
      Style: Flat Squares
      Size (m): 0.10000000149
      Alpha: 0.35
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Failure and PL samples
      Enabled: true
      Marker Topic:
        Value: /iap/failure_map/markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: <Fixed Frame>
  Name: root
