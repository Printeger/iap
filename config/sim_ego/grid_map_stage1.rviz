Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Color: 100; 100; 100
      Alpha: 0.35
    - Class: rviz_default_plugins/PointCloud2
      Name: GridMap physical occupancy
      Enabled: true
      Topic:
        Value: /grid_map/occupancy
      Style: Boxes
      Size (m): 0.1
      Color Transformer: FlatColor
      Color: 58; 62; 68
      Alpha: 1
      Decay Time: 20
    - Class: rviz_default_plugins/PointCloud2
      Name: GridMap inflated obstacles (optional)
      Enabled: false
      Topic:
        Value: /grid_map/occupancy_inflate
      Style: Flat Squares
      Size (m): 0.1
      Color Transformer: FlatColor
      Color: 190; 194; 200
      Alpha: 0.12
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: True PL sample points
      Enabled: true
      Topic:
        Value: /grid_map/risk_slice
      Style: Flat Squares
      Size (m): 0.11
      Color Transformer: RGB8
      Channel Name: rgb
      Alpha: 0.9
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Current PL surface (visual interpolation)
      Enabled: true
      Topic:
        Value: /grid_map/risk_surface
      Queue Size: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: Past PL surfaces (up to 60 s)
      Enabled: true
      Topic:
        Value: /grid_map/risk_history
      Queue Size: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: PL color legend in metres
      Enabled: true
      Topic:
        Value: /grid_map/risk_legend
      Queue Size: 10
    - Class: rviz_default_plugins/Marker
      Name: PL sample status and scale
      Enabled: true
      Topic:
        Value: /grid_map/risk_status
    - Class: rviz_default_plugins/Marker
      Name: Executed B-spline curve
      Enabled: true
      Topic:
        Value: /planning/trajectory_curve
    - Class: rviz_default_plugins/Path
      Name: GLIO trajectory
      Enabled: true
      Topic:
        Value: /grid_map/glio_path
      Buffer Length: 1
      Color: 245; 245; 245
      Alpha: 0.95
      Line Style: Lines
      Line Width: 0.10
      Pose Style: None
    - Class: rviz_default_plugins/Marker
      Name: Goal
      Enabled: true
      Topic:
        Value: /goal_point
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 20; 23; 27
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 31
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Pitch: 0.78
      Yaw: 0.7
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1440
