{
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,

    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 0.0,

    "imu_frame_id": "",
    "lidar_frame_id": "",
    "base_frame_id": "",
    "odom_frame_id": "odom",
    "map_frame_id": "map",
    "publish_imu2lidar": true,
    "tf_time_offset": 1e-6,
    "dump_path": "/tmp/dump",

    "extension_modules": [
      "libgnss_extension.so",
      "libintegrity_extension.so",
      "libdemo8_truth_araim_extension.so",
      "libsim_extension.so",
      "libstandard_viewer.so",
      "librviz_viewer.so"
    ],

    "imu_topic": "/sim/drone_0/imu_iap",
    "points_topic": "/sim/drone_0/lidar_body",
    "image_topic": "/camera/infra1/image_rect_raw",
    "sim": {
      "truth_odom_topic": "/sim/drone_0/truth_odom",
      "planner_odom_topic": "/drone_0_visual_slam/odom",
      "planner_odom_frame_id": "map",
      "planner_body_frame_id": "imu",
      "align_planner_odom_to_truth": true,
      "alignment_mode": "static_window",
      "alignment_min_samples": 20,
      "alignment_max_duration": 8.0,
      "alignment_truth_speed_thresh": 0.05,
      "alignment_est_speed_thresh": 0.05,
      "alignment_publish_before_ready": false,
      "enable_metrics_csv": true,
      "metrics_csv_path": "/tmp/demo8_iap_sim_truth_vs_est.csv",
      "demo8_truth_araim": {
        "enable": true,
        "csv_name": "demo8_araim_truth_compare.csv",
        "truth_odom_topic": "/sim/drone_0/truth_odom",
        "truth_match_tolerance_s": 0.05,
        "truth_cache_duration_s": 8.0,
        "origin_lat_deg": 31.2304,
        "origin_lon_deg": 121.4737,
        "origin_alt_m": 25.0,
        "enable_truth_araim_markers": true,
        "truth_araim_marker_topic": "/iap/araim_truth_envelopes",
        "truth_araim_marker_history_size": 60,
        "truth_araim_marker_publish_period_s": 0.5,
        "truth_araim_marker_min_pl_m": 0.05,
        "truth_araim_marker_max_pl_m": 30.0,
        "truth_araim_marker_show_gnss": true,
        "truth_araim_marker_show_lidar": true,
        "truth_araim_marker_show_final": false,
        "truth_araim_marker_final_hal_m": 10.0,
        "truth_araim_marker_final_val_m": 20.0
      }
    },

    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000,
      "history": "keep_last",
      "reliability": "best_effort",
      "durability": "volatile"
    },
    "points_qos": {
      "profile": "sensor_data",
      "depth": 10,
      "history": "keep_last",
      "reliability": "best_effort",
      "durability": "volatile"
    },
    "image_qos": {
      "profile": "sensor_data",
      "depth": 10,
      "history": "keep_last",
      "reliability": "best_effort",
      "durability": "volatile"
    }
  }
}
