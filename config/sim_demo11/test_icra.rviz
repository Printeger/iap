Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Reference Frame: map
    - Alpha: 0.55
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 190; 195; 200
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Global Obstacle Map
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.035
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_generator/global_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.45
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Predicted PL Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 6
      Size (m): 0.28
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /iap/rviz/predicted_pl_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.45
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: false
      Name: Relative FIM Risk Cloud (P5-P95)
      Size (Pixels): 6
      Size (m): 0.28
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /iap/rviz/risk_relative_cloud
    - Alpha: 0.45
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: false
      Name: GNSS-only Risk Cloud
      Size (Pixels): 6
      Size (m): 0.28
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /iap/rviz/risk_gnss_cloud
    - Alpha: 0.45
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: false
      Name: LiDAR-only Risk Cloud
      Size (Pixels): 6
      Size (m): 0.28
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /iap/rviz/risk_lidar_cloud
    - Alpha: 0.45
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: false
      Name: Pre-conservative FIM Risk Cloud
      Size (Pixels): 6
      Size (m): 0.28
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /iap/rviz/risk_fim_cloud
    - Alpha: 0.3
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: false
      Name: Observed Unknown Coverage
      Size (Pixels): 5
      Size (m): 0.22
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /iap/rviz/risk_validity_cloud
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Planning Lattice Geometry
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /iap/rviz/planning_lattice_geometry
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Risk Grid Health
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /iap/rviz/risk_grid_health
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: P4 AStar Guides
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /iap/rviz/p4_astar_guides
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: P5 Gate Status
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /iap/rviz/p5_gate_status
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Current Trajectory Integrity
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /iap/rviz/current_traj_integrity_colored
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Truth Vehicle
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test_planner/truth/robot
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: IAP Vehicle
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test_planner/drone/robot
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Desired Vehicle
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test_planner/desired/robot
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Truth Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test_planner/truth/path
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: IAP Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test_planner/drone/path
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Desired Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test_planner/desired/path
  Enabled: true
  Global Options:
    Background Color: 18; 18; 22
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 36
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Name: ICRA Overview
      Pitch: 0.65
      Yaw: 3.14
Window Geometry:
  Height: 900
  Width: 1440
