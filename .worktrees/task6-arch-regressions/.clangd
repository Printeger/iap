# .clangd  –  per-project clangd configuration  (IAP-RQ-002)
# Tells clangd where to find the compilation database generated by colcon.
# Place this file at the root of the iap source package (src/iap/).

CompileFlags:
  CompilationDatabase: ../../build/iap   # relative to src/iap/

Diagnostics:
  UnusedIncludes: None   # suppress noise from generated ROS headers
